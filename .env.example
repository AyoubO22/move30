# Copy to .env and fill in. Never commit .env.

# Public URL of the app, exactly as users reach it (no trailing slash).
APP_URL=https://move30.example.com
# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs cookies and encrypts SSO secrets.
APP_SECRET=
POSTGRES_PASSWORD=

# Let anyone create an organization (self-serve trial). Set to false for a single-company install.
ALLOW_SIGNUP=true
# Number of reverse proxies in front of the app (used for client IPs in rate limiting).
TRUST_PROXY=1
# Privacy threshold for team statistics, and how long someone must be in a team before counting toward it.
MIN_GROUP_SIZE=5
TEAM_SETTLE_DAYS=14
SESSION_DAYS=14
INVITE_DAYS=7
# To run as a Microsoft Teams tab, list the Teams origins (space separated):
# FRAME_ANCESTORS=https://teams.microsoft.com https://*.teams.microsoft.com https://*.cloud.microsoft
# Only for self-hosters whose identity provider lives on a private network:
# ALLOW_PRIVATE_SSO_ISSUER=true
